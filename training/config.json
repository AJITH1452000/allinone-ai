{
  "learn_selftrain": {
    "_note": "npm run make-notebook → kaggle/learn_selftrain.ipynb. Trains on data/training/lessons.jsonl (+ pairs.jsonl for DPO).",
    "base_model": "unsloth/Qwen3-4B-unsloth-bnb-4bit",
    "lora_r": 16,
    "lora_alpha": 32,
    "max_seq_length": 8192,
    "epochs": 2,
    "learning_rate": 0.0002,
    "packing": false,
    "val_split": 0.05,
    "dpo_min_pairs": 50,
    "dpo_beta": 0.1,
    "dpo_epochs": 1,
    "dpo_learning_rate": 0.000005,
    "quantization": "q4_k_m"
  }
}
