{
  "name": "allinone-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "build-models": "node models/build.js",
    "eval": "node eval/run.js",
    "storage": "node training/storage.mjs",
    "make-notebook": "node training/make-notebook.mjs",
    "import-model": "node training/import-model.mjs",
    "learn-online": "node tunnel/learn-online.mjs",
    "self-train": "node training/self-train.mjs",
    "load-docs": "node training/load-docs.mjs",
    "add-my-code": "node training/add-my-code.mjs",
    "fetch-open-code": "node training/fetch-open-code.mjs",
    "get-datasets": "node training/get-datasets.mjs",
    "clean-data": "node training/clean-data.mjs",
    "prep-training": "node training/fetch-open-code.mjs && node training/get-datasets.mjs && node training/load-docs.mjs && node training/clean-data.mjs && node training/make-notebook.mjs",
    "compare": "node training/compare.mjs",
    "vendor": "node scripts/vendor.mjs",
    "backup": "node scripts/backup.mjs backup",
    "restore": "node scripts/backup.mjs restore",
    "start:office": "node --permission --allow-fs-read=. --allow-fs-read=%TEMP% --allow-fs-read=%LOCALAPPDATA%/Programs/Ollama --allow-fs-write=./data --allow-fs-write=%TEMP% --allow-child-process server.js",
    "secure-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/office/secure-install.ps1",
    "deps-report": "node scripts/deps-report.mjs",
    "firewall-lock": "powershell -NoProfile -ExecutionPolicy Bypass -File firewall-lock.ps1",
    "firewall-unlock": "powershell -NoProfile -ExecutionPolicy Bypass -File firewall-unlock.ps1",
    "firewall-status": "powershell -NoProfile -ExecutionPolicy Bypass -File status.ps1",
    "learn-autostart": "node tunnel/autostart.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.1.1",
    "@fontsource/noto-sans-tamil": "5.1.1",
    "@fontsource/source-serif-4": "5.1.1",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "bcryptjs": "2.4.3",
    "docx": "9.16.0",
    "dotenv": "16.6.1",
    "esbuild": "0.21.5",
    "express": "4.22.3",
    "helmet": "8.0.0",
    "katex": "0.16.11",
    "mammoth": "1.8.0",
    "otplib": "12.0.1",
    "pdf-parse": "1.1.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "react-syntax-highlighter": "15.6.6",
    "read-excel-file": "5.8.8",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "simple-git-hooks": "2.11.1",
    "vite": "5.4.21"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/precommit-check.mjs"
  }
}
