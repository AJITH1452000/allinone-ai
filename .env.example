# ───────── Evolvix ─────────
# Add only the keys you have. Providers without a key are hidden.

# 1) OLLAMA — 100% FREE + UNLIMITED (runs on your PC, no key)
#    Install: https://ollama.com  then:  ollama pull qwen3  /  ollama pull llama3.2  /  ollama pull gemma3
OLLAMA_URL=http://localhost:11434/v1

# 0) POLLINATIONS — free, no key, enabled by default. Set POLLINATIONS=off to hide it.
# POLLINATIONS=off

# 2) FREE TIERS (daily limits, no card needed)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys   -> many ":free" models
GROQ_API_KEY=            # https://console.groq.com/keys -> very fast Llama / Qwen etc.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
MISTRAL_API_KEY=         # https://console.mistral.ai

# 3) PAID (pay per use)
ANTHROPIC_API_KEY=       # https://console.anthropic.com  -> Claude
OPENAI_API_KEY=          # https://platform.openai.com
DEEPSEEK_API_KEY=        # https://platform.deepseek.com

PORT=3001

# ---------- Office mode (see OFFICE-SETUP.md) — safe defaults ----------
OFFICE_MODE=0                    # 1 = company mode: local only, owner approval for everyone, encryption at rest
HOST=                            # office default 127.0.0.1 (this PC only); 0.0.0.0 = whole LAN (then set the next line + HTTPS)
OFFICE_ALLOWED_IPS=              # e.g. 192.168.1.0/24 — every other IP gets 403 before anything runs
HTTPS_CERT=                      # e.g. C:\Evolvix\certs\evolvix.pem      (mkcert, see OFFICE-SETUP.md)
HTTPS_KEY=                       # e.g. C:\Evolvix\certs\evolvix-key.pem
OFFICE_ALLOWED_PROVIDERS=        # empty = no cloud AI at all (recommended)
OFFICE_ALLOWED_HOSTS=            # extra hosts the server may contact (default: only localhost + the Ollama host)
OFFICE_ALLOW_SEARCH=0            # 1 = the owner MAY switch web search on in Settings → Access
OFFICE_CODE_ALLOWLIST=           # folders add-my-code may read, separated by ;  e.g. C:\Code\app1;C:\Code\app2
OFFICE_MASTER_PASSWORD=          # only if Windows DPAPI is unavailable (min 12 chars) — normally leave empty
EVOLVIX_DATA_DIR=                # optional: another data folder (default .\data)
